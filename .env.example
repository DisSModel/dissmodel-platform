# DisSModel Platform — environment for docker compose
#
#   cp .env.example .env
#
# Only the two secrets marked "change-me" must be set; generate them with
#   openssl rand -hex 32
# Every other value below is the default the stack uses when the variable is
# absent, written out so that you can see and change it.

# ── Secrets ──────────────────────────────────────────────────────────────────
# Password of the MinIO root user (at least 8 characters). The API and the
# worker use it to reach MinIO; researchers never need it.
MINIO_ROOT_PASSWORD=change-me

# Keys accepted in the X-API-Key header, comma-separated, one per person.
API_KEYS=change-me

# ── MinIO (object storage) ───────────────────────────────────────────────────
MINIO_ROOT_USER=inpe_admin
# Address of MinIO inside the Docker network (development stack).
MINIO_ENDPOINT=minio:9000
# Base URL put in presigned download links (GET /download); must be reachable
# from the researcher's machine. Development stack: MinIO API on port 19000.
MINIO_URL=http://localhost:19000
# Do not set MINIO_SECURE here: dissmodel 0.6.6 reads any non-empty value,
# including "false", as true and would try TLS against MinIO.

# ── Redis (queue and records) ────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Ports on the host (development stack) ────────────────────────────────────
API_PORT=8000
JUPYTER_PORT=8888

# ── Model registry ───────────────────────────────────────────────────────────
# Git repository with models/*.toml, pulled by the configs-sync container.
# Empty: no registry (inline jobs only). See docs/getting-started.md, step 7.
CONFIGS_REPO=
CONFIGS_BRANCH=main
CONFIGS_SYNC_INTERVAL=900

# ── Outputs ──────────────────────────────────────────────────────────────────
# Each run writes to <DISSMODEL_OUTPUT_ROOT>/<experiment_id>/: the MinIO bucket
# dissmodel-outputs, or a local path such as /data/outputs/experiments
# (./data/outputs on the host).
DISSMODEL_OUTPUT_ROOT=s3://dissmodel-outputs/experiments

# ── Logging ──────────────────────────────────────────────────────────────────
DISSMODEL_LOG_LEVEL=INFO
